      "console": []
    },
    {
      "id": "BsQw",
      "code_hash": "bda0627ccb3f7f266ddfcfc04f89f0f4",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div class=\"mm-section\">03 \u00b7 A liability waterfall can tell several stories</div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Use the arrow buttons on the evidence board to move an assay earlier or later.\nA molecule can fail several gates. A first-failure waterfall credits only the first\nfailed gate it encounters, so its attribution can change while the final shortlist\nstays fixed. These are accounting choices, not causal explanations of molecular liability.</span></span><marimo-ui-element object-id='BsQw-0' random-id='57127125-3ce0-d4df-681c-4d465f506b5f'><marimo-table data-initial-value='[]' data-label='null' data-data='&quot;[{&#92;&quot;Order&#92;&quot;:1,&#92;&quot;Assay&#92;&quot;:&#92;&quot;Kinetic solubility&#92;&quot;,&#92;&quot;Attributed first failures&#92;&quot;:1329},{&#92;&quot;Order&#92;&quot;:2,&#92;&quot;Assay&#92;&quot;:&#92;&quot;Human microsomal clearance&#92;&quot;,&#92;&quot;Attributed first failures&#92;&quot;:706},{&#92;&quot;Order&#92;&quot;:3,&#92;&quot;Assay&#92;&quot;:&#92;&quot;Caco-2 permeability A\u2192B&#92;&quot;,&#92;&quot;Attributed first failures&#92;&quot;:513}]&quot;' data-total-rows='3' data-total-columns='3' data-max-columns='50' data-banner-text='&quot;&quot;' data-pagination='false' data-page-size='10' data-show-filters='false' data-show-download='true' data-show-search='true' data-show-column-summaries='false' data-show-data-types='true' data-show-page-size-selector='false' data-show-column-explorer='true' data-show-chart-builder='true' data-row-headers='[]' data-hidden-columns='[]' data-has-stable-row-id='false' data-lazy='false' data-preload='false'></marimo-table></marimo-ui-element></div>"
